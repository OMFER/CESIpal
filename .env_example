MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/escuela_db?retryWrites=true&w=majority
PORT=3000
JWT_SECRET=<cadena-larga-y-aleatoria>
# Origen(es) del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173
# Si no existe ningún admin, se crea uno con estas credenciales al arrancar
ADMIN_CORREO=admin@escuela.mx
ADMIN_PASSWORD=<password-inicial>
# Zona horaria de la escuela (IANA); las semanas y los exámenes abren a las 00:00 de esta zona
ZONA_HORARIA=America/Mexico_City
